# Production environment for docker-compose.prod.yml
#
# IMPORTANT:
# - Do NOT commit real secrets
# - Copy to .env on the server and fill values

# Required
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Optional (recommended for password reset links / CORS)
PUBLIC_APP_URL=http://81.31.247.70
CORS_ORIGINS=http://81.31.247.70

# Optional: outgoing mail for password reset
# SMTP_HOST=smtp.reg.ru
# SMTP_PORT=587
# SMTP_USER=no-reply@swift-mind.ru
# SMTP_PASS=CHANGE_ME
# SMTP_FROM="Mikael <no-reply@swift-mind.ru>"
MAIL_STRICT=true
# SMTP_VERIFY=false

# Optional: admin seed credentials (server will create/adminify this user)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=Admin123!



